---
// Toggle for one entry. State and clicks are handled by Bookmarks.astro (included in the layout).
import { t, toLocale } from '../lib/i18n';

interface Props {
  id: string;
}
const { id } = Astro.props;
const strings = t(toLocale(Astro.currentLocale));
---

<button type="button" class="bookmark" data-id={id} aria-pressed="false" aria-label={strings.bookmark} title={strings.bookmark} hidden>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z"></path></svg>
</button>

<style is:global>
  button.bookmark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    color: var(--bg);
    background: var(--fg);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.55;
  }
  button.bookmark:not([hidden]) { display: inline-grid; }
  button.bookmark:hover, button.bookmark:focus-visible { opacity: 0.85; }
  button.bookmark svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
  /* Saved: full strength with a solid icon. */
  button.bookmark[aria-pressed='true'] { opacity: 1; }
  button.bookmark[aria-pressed='true'] svg { fill: currentColor; }
</style>
