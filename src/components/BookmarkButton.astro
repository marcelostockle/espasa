---
// Toggle for one entry. State and clicks are handled by Bookmarks.astro (included in the layout).
import { t, toLocale } from '../lib/i18n';

interface Props {
  id: string;
}
const { id } = Astro.props;
const strings = t(toLocale(Astro.currentLocale));
---

<button type="button" class="bookmark" data-id={id} aria-pressed="false" aria-label={strings.bookmark} title={strings.bookmark} hidden>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z"></path></svg>
</button>
