<div class="search">
  <input id="q" type="search" placeholder="Search entries…" aria-label="Search entries" autocomplete="off" />
  <ul id="results" aria-live="polite"></ul>
</div>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('results')!;
  let pagefind: any;

  // The index is produced by `npm run build`; it doesn't exist under `astro dev`.
  async function load() {
    if (pagefind !== undefined) return pagefind;
    const path = '/pagefind/pagefind.js';
    try {
      pagefind = await import(/* @vite-ignore */ path);
      await pagefind.init();
    } catch {
      pagefind = null;
    }
    return pagefind;
  }

  function message(text: string) {
    list.append(Object.assign(document.createElement('li'), { textContent: text }));
  }

  let timer: number;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(async () => {
      const q = input.value.trim();
      list.replaceChildren();
      if (!q) return;
      const pf = await load();
      if (!pf) return message('Search is available in the built site.');
      const { results } = await pf.search(q);
      const top = await Promise.all(results.slice(0, 8).map((r: any) => r.data()));
      if (!top.length) return message('No matches.');
      for (const r of top) {
        const li = document.createElement('li');
        const a = Object.assign(document.createElement('a'), { href: r.url, textContent: r.meta.title ?? r.url });
        const p = document.createElement('p');
        p.innerHTML = r.excerpt;
        li.append(a, p);
        list.append(li);
      }
    }, 150);
  });
</script>

<style>
  .search { margin: 1rem 0 2rem; }
  input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
  }
  ul { list-style: none; padding: 0; margin: 0.5rem 0 0; }
  li { padding: 0.5rem 0; border-top: 1px solid var(--line); }
  li a { font-weight: 600; }
  li p { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.9rem; }
</style>
