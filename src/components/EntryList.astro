---
import type { CollectionEntry } from 'astro:content';
import BookmarkButton from './BookmarkButton.astro';
import PlaceChips from './PlaceChips.astro';
import { getPlaces } from '../lib/places';
import { localePath, toLocale } from '../lib/i18n';
import { entryText, tagText } from '../lib/localize';
import { formatRange } from '../lib/time';

interface Props {
  entries: CollectionEntry<'entries'>[];
  tags: CollectionEntry<'tags'>[];
}
const { entries, tags } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const tagById = new Map(tags.map((t) => [t.id, t]));
const placeById = new Map((await getPlaces()).map((p) => [p.id, p]));
---

<ol class="entries">
  {
    entries.map((entry) => {
      const text = entryText(entry, locale);
      const lang = text.lang !== locale ? text.lang : undefined;
      return (
      <li>
        <div class="date">{formatRange(entry.data.date, entry.data.end, locale)}</div>
        <div>
          <div class="head">
            <a class="title" href={localePath(locale, `/entries/${entry.id}/`)} lang={lang}>{text.title}</a>
            <BookmarkButton id={entry.id} />
          </div>
          <p lang={lang}>{text.summary}</p>
          <div class="tags">
            {entry.data.tags.map((ref) => {
              const tag = tagById.get(ref.id)!;
              return (
                <a class="chip" style={`--chip:${tag.data.color}`} href={localePath(locale, `/tags/${tag.id}/`)}>
                  {tagText(tag, locale).label}
                </a>
              );
            })}
            <PlaceChips refs={entry.data.places} {placeById} />
          </div>
        </div>
      </li>
      );
    })
  }
</ol>

<style>
  .entries { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; }
  .title { font-weight: 600; font-size: 1.1rem; text-decoration: none; }
  .title:hover { text-decoration: underline; }
  /* Where hover exists, an unsaved entry's button appears only on hover or keyboard focus.
     Saved entries keep theirs visible; touch screens always show it. */
  @media (hover: hover) {
    li :global(button.bookmark[aria-pressed='false']) { opacity: 0; transition: opacity 0.12s; }
    li:hover :global(button.bookmark[aria-pressed='false']),
    li :global(button.bookmark[aria-pressed='false']:focus-visible) { opacity: 0.55; }
    li:hover :global(button.bookmark[aria-pressed='false']:hover) { opacity: 0.85; }
  }
  p { margin: 0.25rem 0 0.5rem; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  @media (max-width: 36rem) {
    li { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
