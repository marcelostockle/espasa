---
interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'A cross-topic timeline of historical events.' } = Astro.props;
const fullTitle = title ? `${title} · Espasa` : 'Espasa';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">Espasa</a>
      <nav>
        <a href="/eras/">Eras</a>
        <a href="/compare/">Compare topics</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <aside class="disclaimer">
      <h2>About this site</h2>
      <ul>
        <li>
          <strong>Not an authoritative source.</strong> Espasa was built for educational purposes only. For
          anything that matters, check primary sources and scholarly references.
        </li>
        <li>
          <strong>Errors are possible.</strong> Some facts, dates and interpretations may be inaccurate or
          incomplete, especially for ancient or disputed events.
        </li>
        <li>
          <strong>Made with AI.</strong> Entries were drafted with the help of an AI model, checked against
          web sources, and reviewed by a human before publication.
        </li>
        <li>
          <strong>Corrections and new entries.</strong> There is no public submission process yet.
        </li>
      </ul>
    </aside>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --fg: #1d1d1b;
    --muted: #6b6b66;
    --line: #dddbd3;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151514;
      --fg: #ecebe6;
      --muted: #9a9a93;
      --line: #35342f;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.55 system-ui, sans-serif;
  }
  a { color: inherit; }
  header.site {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  header.site .brand { font-weight: 700; text-decoration: none; letter-spacing: 0.04em; }
  header.site nav { display: flex; gap: 1.25rem; }
  header.site nav a { color: var(--muted); text-decoration: none; }
  header.site nav a:hover { color: var(--fg); }
  main { margin: 0 auto; padding: 1.5rem 4rem 4rem; }
  h1 { line-height: 1.2; }
  .disclaimer { margin: 0 4rem; padding: 1.5rem 0 3rem; border-top: 1px solid var(--line); }
  .disclaimer h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  .disclaimer ul { margin: 0; padding-left: 1.1rem; color: var(--muted); font-size: 0.9rem; max-width: 46rem; }
  .disclaimer li + li { margin-top: 0.4rem; }
  .disclaimer strong { color: var(--fg); font-weight: 600; }
  .chip {
    display: inline-block;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--chip, var(--line));
    color: var(--chip, var(--fg));
    font-size: 0.8rem;
    text-decoration: none;
  }
  .date { color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
