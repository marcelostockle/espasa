---
import PlacePopup from '../components/PlacePopup.astro';
import { localeNames, localePath, locales, stripLocale, t, toLocale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
}
const locale = toLocale(Astro.currentLocale);
const strings = t(locale);
const { title, description = strings.tagline } = Astro.props;
const fullTitle = title ? `${title} · Espasa` : 'Espasa';
const path = stripLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={localePath(l, path)} />)}
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site">
      <a class="brand" href={localePath(locale, '/')}>Espasa</a>
      <nav>
        <a href={localePath(locale, '/eras/')}>{strings.eras}</a>
        <a href={localePath(locale, '/compare/')}>{strings.compare}</a>
        <span class="langs" aria-label={strings.language}>
          {
            locales.map((l) =>
              l === locale ? (
                <span aria-current="true" lang={l}>{localeNames[l]}</span>
              ) : (
                <a class="switch" href={localePath(l, path)} lang={l} hreflang={l}>{localeNames[l]}</a>
              ),
            )
          }
        </span>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <aside class="disclaimer">
      <h2>{strings.aboutTitle}</h2>
      <ul>
        {
          strings.about.map(([lead, rest]) => (
            <li>
              <strong>{lead}</strong> {rest}
            </li>
          ))
        }
      </ul>
    </aside>
    <footer class="site">
      <a href={localePath(locale, '/contact/')}>{strings.contact}</a>
      <a href={localePath(locale, '/privacy/')}>{strings.privacy}</a>
    </footer>
    <PlacePopup />
    <script>
      // Keep the page's query string (e.g. the Compare view's selection) when switching language.
      document.querySelectorAll<HTMLAnchorElement>('a.switch').forEach((a) => {
        a.href += location.search + location.hash;
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --fg: #1d1d1b;
    --muted: #6b6b66;
    --line: #dddbd3;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151514;
      --fg: #ecebe6;
      --muted: #9a9a93;
      --line: #35342f;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.55 system-ui, sans-serif;
  }
  a { color: inherit; }
  header.site {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  header.site .brand { font-weight: 700; text-decoration: none; letter-spacing: 0.04em; }
  header.site nav { display: flex; gap: 1.25rem; }
  header.site nav a { color: var(--muted); text-decoration: none; }
  header.site nav a:hover { color: var(--fg); }
  header.site .langs { display: flex; gap: 0.6rem; padding-left: 1.25rem; border-left: 1px solid var(--line); font-size: 0.9rem; }
  header.site .langs [aria-current] { color: var(--fg); font-weight: 600; }
  main { margin: 0 auto; padding: 1.5rem 4rem 4rem; }
  h1 { line-height: 1.2; }
  .disclaimer { margin: 0 4rem; padding: 1.5rem 0 3rem; border-top: 1px solid var(--line); }
  .disclaimer h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  .disclaimer ul { margin: 0; padding-left: 1.1rem; color: var(--muted); font-size: 0.9rem; max-width: 46rem; }
  .disclaimer li + li { margin-top: 0.4rem; }
  .disclaimer strong { color: var(--fg); font-weight: 600; }
  .chip {
    display: inline-block;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--chip, var(--line));
    color: var(--chip, var(--fg));
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
  }
  /* Neutral text and border, with the tag color only as a soft gradient wash. */
  .chip.tinted {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--tint) 45%, var(--line));
    background: linear-gradient(90deg, color-mix(in srgb, var(--tint) 24%, transparent), color-mix(in srgb, var(--tint) 6%, transparent));
  }
  footer.site { margin: 0 4rem; padding: 1rem 0 2rem; border-top: 1px solid var(--line); font-size: 0.9rem; }
  footer.site { display: flex; gap: 1.25rem; }
  footer.site a { color: var(--muted); }
  footer.site a:hover { color: var(--fg); }
  .date { color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
