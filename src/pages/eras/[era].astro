---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getTags } from '../../lib/entries';
import { getEraBuckets, formatEraRange } from '../../lib/eras';

export async function getStaticPaths() {
  const [buckets, tags] = await Promise.all([getEraBuckets(), getTags()]);
  const populated = buckets.filter((b) => b.entries.length);
  return populated.map((bucket, i) => ({
    params: { era: bucket.era.id },
    props: { bucket, tags, prev: populated[i - 1]?.era, next: populated[i + 1]?.era },
  }));
}

const { bucket, tags, prev, next } = Astro.props;
---

<Base title={bucket.era.data.label}>
  <p class="date">{formatEraRange(bucket.era)}</p>
  <h1>{bucket.era.data.label}</h1>
  <EntryList entries={bucket.entries} tags={tags} />
  <nav class="adjacent">
    {prev ? <a href={`/eras/${prev.id}/`}>← {prev.data.label}</a> : <span />}
    {next ? <a href={`/eras/${next.id}/`}>{next.data.label} →</a> : <span />}
  </nav>
</Base>

<style>
  .adjacent {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
</style>
