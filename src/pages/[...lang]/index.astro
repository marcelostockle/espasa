---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Search from '../../components/Search.astro';
import TopicBrowser from '../../components/TopicBrowser.astro';
import { getSortedEntries, getTags, groupTagsByCategory } from '../../lib/entries';
import { getEraBuckets, formatEraRange } from '../../lib/eras';
import { localePath, localeStaticPaths, t, toLocale } from '../../lib/i18n';
import { eraLabel, featuredText, tagText } from '../../lib/localize';

export const getStaticPaths = localeStaticPaths;

const locale = toLocale(Astro.currentLocale);
const strings = t(locale);

const [entries, tags, buckets, featured] = await Promise.all([
  getSortedEntries(),
  getTags(locale),
  getEraBuckets(),
  getCollection('featured'),
]);

const counts = new Map<string, number>();
for (const e of entries) for (const t of e.data.tags) counts.set(t.id, (counts.get(t.id) ?? 0) + 1);

const groups = groupTagsByCategory(
  tags.map((tag) => ({ id: tag.id, ...tag.data, label: tagText(tag, locale).label, count: counts.get(tag.id) ?? 0 })),
  locale,
);
const eras = buckets.filter((b) => b.entries.length);

function compareUrl(f: (typeof featured)[number]) {
  const params = new URLSearchParams({ tags: f.data.tags.map((t) => t.id).join(',') });
  if (f.data.from !== undefined) params.set('from', String(f.data.from));
  if (f.data.to !== undefined) params.set('to', String(f.data.to));
  return `${localePath(locale, '/compare/')}?${params}`;
}
---

<Base>
  <h1>{strings.homeTitle}</h1>
  <p class="intro">
    {strings.homeIntro}
  </p>

  <Search />

  {
    featured.length > 0 && (
      <section>
        <h2>{strings.startHere}</h2>
        <ul class="featured">
          {featured.map((f) => (
            <li>
              <a href={compareUrl(f)}>{featuredText(f, locale).title}</a>
              <p>{featuredText(f, locale).description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <h2>{strings.topics}</h2>
    <TopicBrowser locale={locale} groups={groups} />
  </section>

  <section>
    <h2>{strings.byEra}</h2>
    <ul class="eras">
      {
        eras.map(({ era, entries }) => (
          <li>
            <a href={localePath(locale, `/eras/${era.id}/`)}>{eraLabel(era, locale)}</a>
            <span class="date">{formatEraRange(era, locale)} · {entries.length}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .intro { color: var(--muted); font-size: 1.1rem; }
  section { margin-top: 2.5rem; }
  h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  .featured { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .featured li { padding: 1rem; border: 1px solid var(--line); border-radius: 0.5rem; }
  .featured a { font-weight: 600; }
  .featured p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .eras { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .eras li { display: flex; flex-direction: column; }
  .eras a { font-weight: 600; text-decoration: none; }
  .eras a:hover { text-decoration: underline; }
</style>
