---
import Base from '../../../layouts/Base.astro';
import { getEraBuckets, formatEraRange } from '../../../lib/eras';
import { localePath, localeStaticPaths, t, toLocale } from '../../../lib/i18n';
import { eraLabel } from '../../../lib/localize';

export const getStaticPaths = localeStaticPaths;

const locale = toLocale(Astro.currentLocale);
const strings = t(locale);
const buckets = (await getEraBuckets()).filter((b) => b.entries.length);
---

<Base title={strings.eras}>
  <h1>{strings.eras}</h1>
  <p class="date">{strings.erasIntro}</p>
  <ol class="eras">
    {
      buckets.map(({ era, entries }) => (
        <li>
          <a href={localePath(locale, `/eras/${era.id}/`)}>{eraLabel(era, locale)}</a>
          <span class="date">{formatEraRange(era, locale)}</span>
          <span class="count date">{entries.length}</span>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .eras { list-style: none; margin: 1.5rem 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 1fr auto 3rem;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
  }
  li a { font-weight: 600; text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .count { text-align: right; }
</style>
