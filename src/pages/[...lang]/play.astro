---
import Base from '../../layouts/Base.astro';
import { localePath, localeStaticPaths, t, toLocale } from '../../lib/i18n';

export const getStaticPaths = localeStaticPaths;

const locale = toLocale(Astro.currentLocale);
const strings = t(locale);
---

<Base title={strings.play} description={strings.playDescription}>
  <div class="game">
    <h1>{strings.play}</h1>

    <section id="intro">
      <p>{strings.playIntro}</p>
      <button type="button" id="start" class="primary" disabled>{strings.playStart}</button>
      <p id="error" class="date" hidden>{strings.playNeedsData}</p>
    </section>

    <section id="round" hidden>
      <p class="date"><span id="roundlabel"></span></p>
      <p class="edge date">↑ {strings.playEarliest}</p>
      <ol id="cards" class="cards"></ol>
      <p class="edge date">↓ {strings.playLatest}</p>
      <p id="verdict" class="verdict" aria-live="polite" hidden></p>
      <p id="difficulty" class="date" hidden></p>
      <div class="actions">
        <button type="button" id="check" class="primary">{strings.playCheck}</button>
        <button type="button" id="next" class="primary" hidden></button>
      </div>
    </section>

    <section id="results" hidden>
      <h2>{strings.playResults}</h2>
      <p class="total"><span id="total"></span></p>
      <p id="grade" class="date"></p>
      <div id="dots" class="dots" aria-hidden="true"></div>
      <div class="actions">
        <button type="button" id="again" class="primary">{strings.playAgain}</button>
        <button type="button" id="share">{strings.playShare}</button>
      </div>
    </section>
  </div>
  <noscript><p>{strings.needsJs} <a href={localePath(locale, '/')}>{strings.needsJsLink}</a> {strings.needsJsEnd}</p></noscript>
</Base>

<script>
  import { localePath, t, toLocale } from '../../lib/i18n';

  const locale = toLocale(document.documentElement.lang);
  const strings = t(locale);
  const ROUNDS = 5;
  const PAIRS = 6; // 4 items -> 6 pairs

  type Row = [id: string, title: string, date: string, key: number, circa: number, tags: string[], end: number];
  interface Item {
    id: string;
    title: string;
    date: string;
    key: number;
    circa: boolean;
    tags: string[];
    end: number; // equals key for single-date entries
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const intro = $('intro');
  const roundEl = $('round');
  const results = $('results');
  const cards = $<HTMLOListElement>('cards');
  const startBtn = $<HTMLButtonElement>('start');
  const checkBtn = $<HTMLButtonElement>('check');
  const nextBtn = $<HTMLButtonElement>('next');
  const verdict = $('verdict');

  let pool: Item[] = []; // chronological
  let tagInfo: Record<string, [label: string, color: string]> = {};
  const used = new Set<string>();
  let round = 0;
  let scores: number[] = [];
  let order: Item[] = []; // what the player sees, in their current order

  const rand = (n: number) => Math.floor(Math.random() * n);
  function shuffle<T>(a: T[]): T[] {
    for (let i = a.length - 1; i > 0; i--) {
      const j = rand(i + 1);
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // Four events are "unrelated" when they share no tag, and "clear" when they can be ordered
  // fairly: no two spans overlap (a start/end entry never sits alongside anything inside its
  // timeframe), and start dates aren't too close (circa dates need a wider margin).
  const unrelated = (a: Item, b: Item) => !a.tags.some((t) => b.tags.includes(t));
  const clear = (a: Item, b: Item) =>
    (a.key > b.end || b.key > a.end) && Math.abs(a.key - b.key) >= (a.circa || b.circa ? 5 : 1);

  function findSet(window: number): Item[] {
    for (;;) {
      const i = rand(pool.length);
      const anchor = pool[i];
      if (used.has(anchor.id)) continue;
      // Neighbours in the sorted list, so "close in time" adapts to how dense each era is.
      // `window` is how many entries on each side may be drawn from.
      const near = pool.slice(Math.max(0, i - window), i + window + 1).filter((e) => e !== anchor && !used.has(e.id));
      const set = [anchor];
      for (const c of shuffle(near)) {
        if (set.every((s) => unrelated(s, c) && clear(s, c))) set.push(c);
        if (set.length === 4) return set;
      }
    }
  }

  function tagChips(item: Item, link: boolean) {
    const box = document.createElement('span');
    box.className = 'tags';
    for (const id of item.tags) {
      const info = tagInfo[id];
      if (!info) continue;
      const chip = document.createElement(link ? 'a' : 'span');
      chip.className = 'chip tinted';
      chip.style.setProperty('--tint', info[1]);
      chip.textContent = info[0];
      if (link) {
        (chip as HTMLAnchorElement).href = localePath(locale, `/tags/${id}/`);
        (chip as HTMLAnchorElement).dataset.tag = id;
      }
      box.append(chip);
    }
    return box;
  }

  // Difficulty = how many of the 6 pairs a typical player gets right (6 = trivial, 3 = coin flips).
  // Each pair is 50% at zero gap and approaches 100% as the gap grows relative to tau, which
  // widens for older dates because our sense of distant time is coarser. Circa dates are fuzzier.
  function expectedScore(set: Item[]): number {
    let total = 0;
    for (let i = 0; i < set.length; i++)
      for (let j = i + 1; j < set.length; j++) {
        const [a, b] = [set[i], set[j]];
        const tau = 5 + 0.02 * Math.max(0, 2026 - Math.min(a.key, b.key));
        const gap = Math.max(0, Math.abs(a.key - b.key) - (a.circa ? 3 : 0) - (b.circa ? 3 : 0));
        total += 0.5 + 0.5 * (1 - Math.exp(-gap / tau));
      }
    return total;
  }
  // Band cutoffs match the ramp below: rounds 1-2 land in Easy, round 3 in Medium, round 5 in Hard.
  const level = (score: number) => (score < 4.6 ? 0 : score < 5.3 ? 1 : 2);
  // Target expected score per round: starts easy, ends hard.
  const TARGETS = [5.8, 5.45, 5.0, 4.5, 4.0];
  // Easy rounds need events far apart, so they draw from a wide slice of the timeline;
  // hard rounds stay narrow so the events really are close.
  const WINDOWS = [400, 200, 80, 30, 30];

  function pickSet(): Item[] {
    const r = Math.min(round, TARGETS.length - 1);
    const target = TARGETS[r];
    let best: Item[] = [];
    let bestDist = Infinity;
    for (let n = 0; n < 50; n++) {
      const set = findSet(WINDOWS[r]);
      const dist = Math.abs(expectedScore(set) - target);
      if (dist < bestDist) [best, bestDist] = [set, dist];
    }
    return best;
  }

  function render() {
    cards.replaceChildren();
    order.forEach((item, i) => {
      const li = document.createElement('li');
      const title = document.createElement('span');
      title.className = 'title';
      title.textContent = item.title;
      const ctl = document.createElement('span');
      ctl.className = 'ctl';
      for (const [dir, label, glyph] of [[-1, strings.playMoveUp, '▲'], [1, strings.playMoveDown, '▼']] as const) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = glyph;
        b.setAttribute('aria-label', `${label}: ${item.title}`);
        b.disabled = i + dir < 0 || i + dir >= order.length;
        b.addEventListener('click', () => {
          const j = i + dir;
          [order[i], order[j]] = [order[j], order[i]];
          render();
          // Keep keyboard focus on the same control after the re-render.
          const moved = cards.children[j].querySelectorAll('button');
          (moved[dir === -1 ? 0 : 1] as HTMLButtonElement).focus();
        });
        ctl.append(b);
      }
      li.append(title, ctl, tagChips(item, false));
      cards.append(li);
    });
  }

  function startRound() {
    verdict.hidden = true;
    $('difficulty').hidden = true;
    nextBtn.hidden = true;
    checkBtn.hidden = false;
    $('roundlabel').textContent = `${strings.playRound} ${round + 1} ${strings.playOf} ${ROUNDS}`;
    const set = pickSet();
    set.forEach((s) => used.add(s.id));
    // Never start already sorted.
    do shuffle(set);
    while (set.every((s, i, a) => i === 0 || a[i - 1].key <= s.key));
    order = set;
    render();
  }

  async function check() {
    // Score = pairs of events the player put in the right relative order.
    let right = 0;
    for (let i = 0; i < order.length; i++)
      for (let j = i + 1; j < order.length; j++) if (order[i].key < order[j].key) right++;
    scores.push(right);

    const truth = [...order].sort((a, b) => a.key - b.key);
    const summaries = await summariesPromise;
    cards.replaceChildren();
    // Keep the player's order, so reading down the dates shows where it went wrong.
    order.forEach((item, pos) => {
      const ok = truth[pos] === item;
      const li = document.createElement('li');
      li.className = ok ? 'right' : 'wrong';
      const title = document.createElement('a');
      title.className = 'title';
      title.href = localePath(locale, `/entries/${item.id}/`);
      title.textContent = item.title;
      title.title = strings.playOpenEntry;
      const date = document.createElement('span');
      date.className = 'date';
      date.textContent = `${ok ? '✓' : '✗'} ${item.date}`;
      li.append(title, date, tagChips(item, true));
      const summary = summaries.get(item.id);
      if (summary) {
        const p = document.createElement('p');
        p.className = 'summary';
        p.textContent = summary;
        li.append(p);
      }
      cards.append(li);
    });

    const expected = expectedScore(order);
    const diff = $('difficulty');
    diff.textContent = `${strings.playDifficulty}: ${strings.playLevels[level(expected)]} · ${strings.playExpected} ${expected.toFixed(1)}/${PAIRS}`;
    diff.hidden = false;

    const line = `${right}/${PAIRS} ${strings.playPairs}`;
    verdict.textContent = right === PAIRS ? `${strings.playPerfect} ${line}` : line;
    verdict.hidden = false;
    checkBtn.hidden = true;
    nextBtn.textContent = round + 1 === ROUNDS ? strings.playSeeResults : strings.playNext;
    nextBtn.hidden = false;
    nextBtn.focus();
  }

  // Summaries are only needed at the reveal, so they come from the timeline index and not game.json.
  let summariesPromise: Promise<Map<string, string>> = Promise.resolve(new Map());
  function loadSummaries() {
    summariesPromise = fetch(localePath(locale, '/timeline.json'))
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d: { entries: { id: string; summary: string }[] }) => new Map(d.entries.map((e) => [e.id, e.summary])))
      .catch(() => new Map());
  }

  const sum = () => scores.reduce((a, b) => a + b, 0);

  function finish() {
    roundEl.hidden = true;
    results.hidden = false;
    const max = ROUNDS * PAIRS;
    const pct = Math.round((sum() / max) * 100);
    $('total').textContent = `${sum()} / ${max} (${pct}%)`;
    const g = strings.playGrades;
    $('grade').textContent = g[Math.min(g.length - 1, Math.floor((pct / 100) * g.length))];
    $('dots').replaceChildren(
      ...scores.map((s) => {
        const d = document.createElement('span');
        d.textContent = `${s}/${PAIRS}`;
        d.className = s === PAIRS ? 'full' : '';
        return d;
      }),
    );
    $('again').focus();
  }

  function begin() {
    if (!scores.length && round === 0) loadSummaries();
    used.clear();
    scores = [];
    round = 0;
    intro.hidden = true;
    results.hidden = true;
    roundEl.hidden = false;
    startRound();
  }

  startBtn.addEventListener('click', begin);
  $('again').addEventListener('click', begin);
  checkBtn.addEventListener('click', check);
  nextBtn.addEventListener('click', () => {
    round++;
    if (round >= ROUNDS) finish();
    else startRound();
  });
  $('share').addEventListener('click', async (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement;
    const squares = scores.map((s) => (s === PAIRS ? '🟩' : s >= 4 ? '🟨' : '🟥')).join('');
    const text = `Espasa · ${strings.play}: ${sum()}/${ROUNDS * PAIRS}\n${squares}\n${location.href}`;
    try {
      await navigator.clipboard.writeText(text);
      const old = btn.textContent;
      btn.textContent = strings.playCopied;
      setTimeout(() => (btn.textContent = old), 1500);
    } catch {
      // Clipboard unavailable: nothing to do.
    }
  });

  fetch(localePath(locale, '/game.json'))
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((data: { tags: typeof tagInfo; entries: Row[] }) => {
      tagInfo = data.tags;
      pool = data.entries.map(([id, title, date, key, circa, tags, end]) => ({ id, title, date, key, circa: !!circa, tags, end }));
      startBtn.disabled = false;
    })
    .catch(() => ($('error').hidden = false));
</script>

<style is:global>
  .game { max-width: 40rem; margin: 0 auto; }
  .game button { font: inherit; color: var(--fg); background: transparent; border: 1px solid var(--line); border-radius: 0.4rem; padding: 0.4rem 0.9rem; cursor: pointer; }
  .game button:hover:not(:disabled) { border-color: var(--muted); }
  .game button:disabled { opacity: 0.35; cursor: default; }
  .game button.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .game [hidden] { display: none; }
  .game .actions { display: flex; gap: 0.75rem; margin-top: 1rem; }
  .game .cards { list-style: none; margin: 0.5rem 0; padding: 0; display: grid; gap: 0.5rem; }
  .game .cards li { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; padding: 0.7rem 0.9rem; border: 1px solid var(--line); border-radius: 0.5rem; }
  .game .cards .title { flex: 1 1 14rem; font-weight: 600; }
  .game .cards a.title { text-decoration-color: var(--line); }
  .game .tags { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .game .ctl { display: flex; gap: 0.35rem; }
  .game .ctl button { padding: 0.25rem 0.6rem; }
  .game .edge { margin: 0; font-size: 0.85rem; text-align: center; }
  .game { --confirm: #1f9d55; --confirm-fg: #15703c; }
  @media (prefers-color-scheme: dark) { .game { --confirm: #3ddc84; --confirm-fg: #6fe8a4; } }
  .game .cards li.right { border-color: var(--confirm); background: color-mix(in srgb, var(--confirm) 16%, transparent); }
  .game .cards li.right > .date { color: var(--confirm-fg); font-weight: 600; }
  .game .cards li.wrong { border-color: #b4483c; background: color-mix(in srgb, #b4483c 10%, transparent); }
  .game .summary { flex-basis: 100%; margin: 0; font-size: 0.9rem; color: var(--muted); }
  .game .verdict { font-weight: 600; margin: 0.75rem 0 0; }
  .game .total { font-size: 2rem; font-weight: 700; margin: 0.25rem 0; }
  .game .dots { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
  .game .dots span { padding: 0.2rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; font-variant-numeric: tabular-nums; }
  .game .dots span.full { border-color: var(--confirm); }
  @media (max-width: 40rem) { main:has(.game) { padding-inline: 1.25rem; } }
</style>
