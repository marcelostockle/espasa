---
import Base from '../../layouts/Base.astro';
import { localePath, localeStaticPaths, t, toLocale } from '../../lib/i18n';

export const getStaticPaths = localeStaticPaths;

const locale = toLocale(Astro.currentLocale);
const strings = t(locale);
---

<Base title={strings.compare} description={strings.compareDescription}>
  <h1>{strings.compare}</h1>
  <p class="date">{strings.compareIntro}</p>
  <div class="range">
    <label>{strings.fromYear} <input id="from" type="number" step="1" placeholder={strings.any} /></label>
    <label>{strings.toYear} <input id="to" type="number" step="1" placeholder={strings.any} /></label>
    <span class="date">{strings.bceHint}</span>
    <label><input id="detail" type="checkbox" /> {strings.showSummaries}</label>
    <label><input id="single" type="checkbox" /> {strings.singleLane}</label>
  </div>
  <div id="picker" class="picker" role="group" aria-label={strings.topics}></div>
  <div id="grid" class="grid" aria-live="polite"></div>
  <noscript><p>{strings.needsJs} <a href={localePath(locale, '/')}>{strings.needsJsLink}</a> {strings.needsJsEnd}</p></noscript>
</Base>

<script>
  import { categoryName, localePath, t, toLocale } from '../../lib/i18n';

  const locale = toLocale(document.documentElement.lang);
  const strings = t(locale);

  interface Index {
    tags: { id: string; label: string; color: string; categories: string[] }[];
    entries: { id: string; title: string; summary: string; date: string; key: number; year: number; endYear: number; tags: string[] }[];
  }

  const picker = document.getElementById('picker')!;
  const grid = document.getElementById('grid')!;
  const selected = new Set(
    (new URLSearchParams(location.search).get('tags') ?? '').split(',').filter(Boolean),
  );

  const fromInput = document.getElementById('from') as HTMLInputElement;
  const toInput = document.getElementById('to') as HTMLInputElement;
  const params = new URLSearchParams(location.search);
  fromInput.value = params.get('from') ?? '';
  toInput.value = params.get('to') ?? '';
  const detailInput = document.getElementById('detail') as HTMLInputElement;
  detailInput.checked = params.get('view') === 'detailed';
  const singleInput = document.getElementById('single') as HTMLInputElement;
  let preferSingle = params.get('lanes') !== 'multi';
  const narrow = window.matchMedia('(max-width: 40rem)');

  // Narrow screens can't fit parallel lanes, so single lane is forced there
  // without overwriting the user's stored preference.
  function isSingle() {
    return narrow.matches || preferSingle;
  }

  function syncUrl() {
    const p = new URLSearchParams();
    if (selected.size) p.set('tags', [...selected].join(','));
    if (fromInput.value !== '') p.set('from', fromInput.value);
    if (toInput.value !== '') p.set('to', toInput.value);
    if (detailInput.checked) p.set('view', 'detailed');
    if (!preferSingle) p.set('lanes', 'multi');
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function render(index: Index) {
    const tags = index.tags.filter((t) => selected.has(t.id));
    const counts = new Map<string, number>();
    for (const e of index.entries) for (const id of e.tags) counts.set(id, (counts.get(id) ?? 0) + 1);
    const groups = new Map<string, Index['tags']>();
    for (const t of index.tags) {
      for (const c of t.categories?.length ? t.categories : ['Other']) {
        groups.set(c, [...(groups.get(c) ?? []), t]);
      }
    }
    const ordered = [...groups].sort(([a], [b]) =>
      a === 'Other' ? 1 : b === 'Other' ? -1 : categoryName(a, locale).localeCompare(categoryName(b, locale), locale),
    );
    picker.replaceChildren(
      ...ordered.map(([category, members]) => {
        const group = document.createElement('div');
        group.className = 'pickgroup';
        const title = document.createElement('h3');
        title.textContent = categoryName(category, locale);
        const row = document.createElement('div');
        row.className = 'pickrow';
        row.append(
          ...members.map((t) => {
            const label = document.createElement('label');
            label.className = 'chip pick';
            label.style.setProperty('--chip', t.color);
            const box = document.createElement('input');
            box.type = 'checkbox';
            box.checked = selected.has(t.id);
            box.addEventListener('change', () => {
              box.checked ? selected.add(t.id) : selected.delete(t.id);
              syncUrl();
              render(index);
            });
            const n = document.createElement('span');
            n.className = 'n';
            n.textContent = String(counts.get(t.id) ?? 0);
            label.append(box, ' ', t.label, ' ', n);
            return label;
          }),
        );
        group.append(title, row);
        return group;
      }),
    );

    if (!tags.length) {
      grid.replaceChildren(Object.assign(document.createElement('p'), { textContent: strings.selectOne }));
      return;
    }

    const single = isSingle();
    singleInput.disabled = narrow.matches;
    singleInput.checked = single;
    grid.classList.toggle('single', single);
    grid.style.setProperty('--cols', String(tags.length));
    const head = [document.createElement('div'), ...tags.map((t) => {
      const h = document.createElement('div');
      h.className = 'colhead';
      h.textContent = t.label;
      h.style.color = t.color;
      return h;
    })];

    const from = fromInput.value === '' ? -Infinity : Number(fromInput.value);
    const to = toInput.value === '' ? Infinity : Number(toInput.value);
    const rows = index.entries
      .filter((e) => e.tags.some((id) => selected.has(id)) && e.endYear >= from && e.year <= to)
      .flatMap((e) => {
        const date = document.createElement('div');
        date.className = 'date rowdate';
        date.textContent = e.date;
        if (single) {
          const own = tags.filter((t) => e.tags.includes(t.id));
          const a = document.createElement('a');
          a.className = 'laneitem';
          a.href = localePath(locale, `/entries/${e.id}/`);
          const stops = own.map((t) => `color-mix(in srgb, ${t.color} 16%, transparent)`);
          stops.push('transparent');
          a.style.background = `linear-gradient(90deg, ${stops.join(', ')})`;
          a.style.borderLeftColor = own[0].color;
          const names = document.createElement('span');
          names.className = 'lanenames';
          names.append(
            ...own.map((t) => {
              const n = document.createElement('strong');
              n.textContent = t.label;
              n.style.color = t.color;
              return n;
            }),
          );
          const title = document.createElement('span');
          title.className = 'lanetitle';
          title.textContent = e.title;
          a.append(names, title);
          if (detailInput.checked) {
            const s = document.createElement('span');
            s.className = 'summary';
            s.textContent = e.summary;
            a.append(s);
          }
          return [date, a];
        }
        const cells = tags.map((t) => {
          const cell = document.createElement('div');
          cell.className = 'cell';
          if (e.tags.includes(t.id)) {
            const a = document.createElement('a');
            a.href = localePath(locale, `/entries/${e.id}/`);
            a.textContent = e.title;
            a.style.borderLeftColor = t.color;
            if (detailInput.checked) {
              const s = document.createElement('span');
              s.className = 'summary';
              s.textContent = e.summary;
              a.append(s);
            }
            cell.append(a);
          }
          return cell;
        });
        return [date, ...cells];
      });

    grid.replaceChildren(...(single ? [] : head), ...rows);
  }

  let loaded: Index;
  for (const input of [fromInput, toInput, detailInput, singleInput]) {
    input.addEventListener('change', () => {
      if (input === singleInput) preferSingle = singleInput.checked;
      syncUrl();
      render(loaded);
    });
  }
  narrow.addEventListener('change', () => render(loaded));

  const res = await fetch(localePath(locale, '/timeline.json'));
  loaded = (await res.json()) as Index;
  render(loaded);
</script>

<style is:global>
  .picker { display: flex; gap: 1rem 2.5rem; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
  .pickgroup h3 { margin: 0 0 0.25rem; font-size: 0.95rem; }
  .pickrow { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .pickrow .n { opacity: 0.7; font-variant-numeric: tabular-nums; }
  .range { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-top: 1rem; }
  .range input {
    width: 7rem;
    padding: 0.3rem 0.5rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
  }
  .range input[type="checkbox"] {
    width: auto;
    margin-right: 0.25rem;
  }
  .pick { cursor: pointer; }
  .pick:has(input:checked) { background: color-mix(in srgb, var(--chip) 18%, transparent); }
  .pick input { accent-color: var(--chip); }
  .grid {
    display: grid;
    grid-template-columns: 9rem repeat(var(--cols, 1), minmax(9rem, 1fr));
    gap: 0.5rem 0.75rem;
    overflow-x: auto;
  }
  .grid.single { grid-template-columns: 9rem 1fr; }
  .laneitem {
    display: block;
    padding: 0.35rem 0.75rem;
    border-left: 4px solid var(--line);
    text-decoration: none;
  }
  .laneitem:hover .lanetitle { text-decoration: underline; }
  .lanenames strong { margin-right: 0.6rem; }
  @media (max-width: 40rem) {
    .grid.single { grid-template-columns: 1fr; gap: 0.1rem; }
    .grid.single .rowdate { padding-top: 0.6rem; }
  }
  .colhead { font-weight: 700; padding-bottom: 0.25rem; border-bottom: 1px solid var(--line); }
  .rowdate { padding-top: 0.35rem; }
  .cell a {
    display: block;
    padding: 0.3rem 0.6rem;
    border-left: 4px solid var(--line);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    text-decoration: none;
  }
  .cell a:hover .summary { text-decoration: none; }
  .cell a:hover { text-decoration: underline; }
  .summary { display: block; margin-top: 0.2rem; font-size: 0.85rem; color: var(--muted); }
</style>
