---
// Cloudflare serves /404.html for every miss, whatever the language of the URL, so this page shows
// both languages instead of guessing one.
import Base from '../layouts/Base.astro';
import { localePath, locales, t } from '../lib/i18n';
---

<Base title={t('en').notFoundTitle}>
  <div class="not-found">
    {
      locales.map((l) => (
        <section lang={l}>
          <h1>{t(l).notFoundTitle}</h1>
          <p>{t(l).notFoundBody}</p>
          <p><a href={localePath(l, '/')}>{t(l).backHome}</a></p>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .not-found { max-width: 46rem; }
  .not-found section + section { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .not-found h1 { margin-top: 0; }
</style>
