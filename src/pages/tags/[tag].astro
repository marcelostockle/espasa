---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getSortedEntries, getTags } from '../../lib/entries';

export async function getStaticPaths() {
  const [entries, tags] = await Promise.all([getSortedEntries(), getTags()]);
  return tags.map((tag) => ({
    params: { tag: tag.id },
    props: {
      tag,
      tags,
      entries: entries.filter((e) => e.data.tags.some((t) => t.id === tag.id)),
    },
  }));
}

const { tag, tags, entries } = Astro.props;
---

<Base title={tag.data.label} description={tag.data.description}>
  <h1 style={`color:${tag.data.color}`}>{tag.data.label}</h1>
  {tag.data.description && <p class="date">{tag.data.description}</p>}
  {tag.data.categories.length > 0 && <p class="date">Category: {tag.data.categories.join(', ')}</p>}
  <p><a href={`/compare/?tags=${tag.id}`}>Compare with other topics →</a></p>
  <EntryList entries={entries} tags={tags} />
</Base>
